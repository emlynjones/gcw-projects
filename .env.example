# --- Core ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=changeme
AUTH_URL=https://projects.cambrianweb.dev
DATABASE_URL=file:./dev.db

# --- Microsoft Entra ID (GCW staff SSO) ---
GCW_O365_TENANT_ID=<directory-tenant-id>
GCW_O365_CLIENT_ID=<application-client-id>
GCW_O365_CLIENT_SECRET='<client-secret-value>'
# Explicit Microsoft sign-in addresses (UPNs); empty denies every Microsoft login.
GCW_ADMIN_ALLOWED=you@cambrianweb.com,colleague@cambrianweb.com

# --- Admin credentials login (seeded on container start) ---
ADMIN_EMAIL=emlyn@cambrianweb.com
ADMIN_NAME=Emlyn Jones
ADMIN_PASSWORD=changeme

# --- Xero (optional until connected) ---
# Create a "Web app" at https://developer.xero.com/app/manage
# Redirect URI: https://projects.cambrianweb.dev/api/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- MCP API ---
# Generate with: openssl rand -hex 32
MCP_API_KEY=changeme
